{
  "expo": {
    "owner": "kamilabbasi",
    "name": "Sensors Test",
    "slug": "sensors-test",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kamilabbasi.sensorstest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kamilabbasi.sensorstest"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sensors Test uses your location to correct the compass for true north."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Sensors Test uses device motion to count your steps and track your direction."
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "7a95877f-836b-4605-9188-e48782b3cead"
      }
    }
  }
}
